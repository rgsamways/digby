# Copy to .env and fill in values. Never commit .env.

# ── Backend ──────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digby?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLATFORM_FEE_PERCENT=12

BACKEND_CORS_ORIGINS=http://localhost:3000,https://digby.rocks

ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OGS geology map tilesets — add after uploading shapefiles to Mapbox Studio
# Format: yourusername.xxxxxxxx  (found in Mapbox Studio → Tilesets)
NEXT_PUBLIC_MAPBOX_TILESET_BEDROCK=
NEXT_PUBLIC_MAPBOX_TILESET_MINERAL_OCCURRENCES=
NEXT_PUBLIC_MAPBOX_TILESET_PAST_MINES=
